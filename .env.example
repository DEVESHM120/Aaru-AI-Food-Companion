# ─── Auth (NextAuth / Auth.js) ───────────────────────────────────────────────
# Generate: npx auth secret
AUTH_SECRET=REPLACE_ME
# Google OAuth — create at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=REPLACE_ME
AUTH_GOOGLE_SECRET=REPLACE_ME

# ─── Groq (rotating pool — add up to 5 keys, all are used randomly) ─────────
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_API_KEY_2=gsk_REPLACE_ME
GROQ_API_KEY_3=gsk_REPLACE_ME
GROQ_API_KEY_4=gsk_REPLACE_ME
GROQ_API_KEY_5=gsk_REPLACE_ME

# ─── ElevenLabs TTS (rotating pool — add up to 5 keys) ──────────────────────
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_API_KEY_2=REPLACE_ME
ELEVENLABS_API_KEY_3=REPLACE_ME
ELEVENLABS_API_KEY_4=REPLACE_ME
ELEVENLABS_API_KEY_5=REPLACE_ME
# Rachel voice ID. Change to any ElevenLabs voice ID you like.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Zomato MCP (real ordering) ─────────────────────────────────────────────
# Guide: https://agnost.ai/blog/zomato-mcp-server-order-food-claude-desktop/
# Leave blank to use demo mode (mock data)
ZOMATO_MCP_AUTH_TOKEN=

# ─── Swiggy MCP (real ordering) ─────────────────────────────────────────────
# Repo: https://github.com/Swiggy/swiggy-mcp-server-manifest
# Leave blank to use demo mode (mock data)
SWIGGY_MCP_AUTH_TOKEN=
NEXT_PUBLIC_SWIGGY_OAUTH=true
SWIGGY_MCP_CLIENT_ID=REPLACE_ME
NEXTAUTH_URL=http://localhost:3000

# Supabase (server memory + profiles, cross-device)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
